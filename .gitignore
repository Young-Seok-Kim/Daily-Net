# [IDE 환경 설정 및 캐시]
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
/.idea/modules
/.idea/deploymentTargetDropDown.xml
*.iml

# [빌드 결과물]
/build
/*/build
/captures
.externalNativeBuild
.cxx

# [코틀린 및 로그]
*.kt.bak
*.kts.bak
/captures

# [OS 및 기타 환경 파일]
.DS_Store
local.properties

# [Secrets - 매우 중요]
# API 키 보안을 위해 Secrets Gradle Plugin을 쓰신다면 아래 파일도 제외해야 합니다.
secrets.properties

# Google Services (API 키 포함 - 매우 위험)
google-services.json
**/google-services.json
app/google-services.json

# functions/.gitignore
node_modules/          # 용량만 차지하는 라이브러리 (npm install로 재생성 가능)
npm-debug.log*         # 에러 로그
.runtimeconfig.json    # 로컬 환경 변수 (민감 정보 포함 가능)
lib/                   # TS 사용 시 빌드된 JS 파일