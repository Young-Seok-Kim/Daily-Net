<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Health Connect: 걸음 수 읽기 -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- 30일보다 오래된 날짜의 걸음 수를 읽기 위해 필요 (지원 기기에서만 요청) -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />

    <!-- 공휴일: 기기 캘린더의 휴일 캘린더 읽기 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- 정산 리마인더 알림 (안드로이드 13부터 런타임 권한 필요) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      음식 사진을 앱 안에서 직접 찍기 위한 권한.
      시스템 카메라 앱은 셔터음을 끌 수 없어서 CameraX로 직접 촬영한다.
      카메라 없는 기기에서도 설치는 되도록 required=false로 둔다 (갤러리 선택은 가능).
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!--
      CAMERA 권한을 선언하면 플레이 스토어가 후면 카메라와 자동초점을 필수 기능으로 간주해
      그게 없는 기기(태블릿·크롬북 등)를 지원 목록에서 빼버린다. 셋 다 required=false로 풀어준다.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <queries>
        <!-- Health Connect 앱(안드로이드 13 이하) 존재 여부 확인용 -->
        <package android:name="com.google.android.apps.healthdata" />
        <!--
          손목닥터9988 설치 여부 확인용 (WristDoctorLauncher.PACKAGE와 같아야 한다).
          안드로이드 11부터는 여기 적지 않은 패키지는 getLaunchIntentForPackage가 null을 돌려준다.
        -->
        <package android:name="kr.go.seoul.healthcare" />
    </queries>

    <application
        android:name=".ui.view.DailyNetApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DailyNet"
        tools:targetApi="31">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DailyNet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect 권한 사용 이유 화면 (Android 13 이하) -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!--
          앱 내 카메라가 찍은 임시 사진을 content URI로 다루기 위한 provider.
          갤러리에서 고른 사진과 같은 형태(URI)로 인식 로직에 넘길 수 있다.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          홈 화면 위젯 (오늘의 순칼로리).
          시스템이 명시적 컴포넌트로 브로드캐스트를 보내므로 exported는 false로 둔다.
        -->
        <receiver
            android:name=".widget.TodayWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- Health Connect 권한 사용 이유 화면 (Android 14 이상) -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".ui.MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>