<?xml version="1.0" encoding="utf-8"?>
<!--
  어댑티브 아이콘 전경 — "정산 게이지" (A안).
  민트 링 300° + 끊긴 자리의 코랄 점 + 가운데 흰 불꽃(먹고 움직인 열량).
  마크는 108dp 캔버스의 중앙 66dp 안전영역 안에만 둔다 (원·스쿼클 마스크에 잘리지 않게).
  좌표는 아래 ic_launcher_monochrome.xml, 그리고 래스터(플레이 512·웹 192·legacy mipmap)를 뽑는
  build 스크립트(tools/make_icons.py)와 같아야 한다.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 링: 반지름 26, 굵기 4.5, 오른쪽 위 60° 는 비운다 -->
    <path
        android:pathData="M79.11,47.27 A26,26 0 1 1 60.73,28.89"
        android:strokeColor="#5FE1B0"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <!-- 코랄 점: 링이 끊긴 자리 -->
    <path
        android:fillColor="#FF4D2E"
        android:pathData="M73.4,34.6 m-3.6,0 a3.6,3.6 0 1 1 7.2,0 a3.6,3.6 0 1 1 -7.2,0" />
    <!-- 불꽃: 바깥 윤곽에서 안쪽 결을 뺀다 (evenOdd) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,34 C58,42 67,47 67,58 C67,68 61,74 54,76 C47,74 41,68 41,58 C41,47 50,42 54,34 Z M55.5,46 C59.5,52 61.5,56.5 60.5,62.5 C59.5,67.5 56.5,70.5 54,72.5 C55,68 56,63.5 54.2,58.5 C52.8,54.5 54,50 55.5,46 Z" />
</vector>
