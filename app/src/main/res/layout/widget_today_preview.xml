<?xml version="1.0" encoding="utf-8"?>
<!--
  위젯 선택 화면에 보여줄 미리보기.

  실제 위젯은 Glance가 그리지만, 미리보기는 시스템 런처가 인플레이트하므로
  RemoteViews로 만들 수 있는 일반 레이아웃이어야 한다.
  테마 속성(?attr/...)은 런처 컨텍스트에서 해석되지 않을 수 있어 색을 직접 지정한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_preview_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- 기본 크기가 2x1이므로 미리보기도 그 레이아웃(큰 숫자 + 설명)에 맞춘다 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-420"
        android:textColor="#2E7D32"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_kcal_today"
        android:textColor="#6E6A75"
        android:textSize="11sp" />

</LinearLayout>
