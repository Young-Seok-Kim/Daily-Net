<?xml version="1.0" encoding="utf-8"?>
<!--
   안드로이드 12 이상의 백업·기기 이전 규칙. 이유는 backup_rules.xml 주석 참고.
   로컬 DB는 빼고 설정은 남긴다. 기기 이전 때도 같다 — 새 기기에서 서버에서 받는 게 맞다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
