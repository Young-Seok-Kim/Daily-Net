<?xml version="1.0" encoding="utf-8"?>
<!--
  Remote Config 값을 아직 못 받았을 때(첫 실행, 비행기 모드, Firebase 장애) 사용하는 기본값.

  두 버전 기준을 모두 0으로 둔다. 어떤 앱 버전이든 0보다는 크므로,
  값을 못 받은 사용자의 앱이 업데이트 안내에 갇히는 일은 절대 생기지 않는다.
  실제 기준값은 Firebase 콘솔의 Remote Config에서 정한다.
-->
<defaultsMap>
    <!-- 이 값보다 낮은 versionCode는 강제 업데이트 (다이얼로그를 닫을 수 없음) -->
    <entry>
        <key>min_version_code</key>
        <value>0</value>
    </entry>

    <!-- 이 값보다 낮은 versionCode는 권장 업데이트 (하루 한 번만 안내, 닫기 가능) -->
    <entry>
        <key>recommend_version_code</key>
        <value>0</value>
    </entry>

    <!--
      다이얼로그 본문. 강제와 권장은 상황이 달라 문구를 따로 둔다.
      비워두면 앱에 내장된 기본 문구를 쓴다.
    -->
    <entry>
        <key>force_update_message</key>
        <value></value>
    </entry>

    <entry>
        <key>recommend_update_message</key>
        <value></value>
    </entry>
</defaultsMap>
