rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /**
     * 서버(Cloud Functions)만 쓸 수 있는 필드.
     *
     * 사진 인식 횟수는 quota.js가 트랜잭션으로 세는 값이라, 앱이 손댈 수 있으면
     * 세는 의미가 없다 (0으로 덮으면 하루 상한이 그대로 풀린다).
     * Admin SDK는 이 규칙을 우회하므로 서버 코드는 영향을 받지 않는다.
     *
     * ⚠️ 분석 횟수(todayAnalysisCount / lastAnalyzedDate)와 구독 여부(isSubscribed)도
     * 같은 이유로 여기 들어가야 하지만, 아직 앱이 직접 쓰고 있어 지금 막으면
     * 신규 가입과 결제가 실패한다. 앱에서 해당 쓰기를 걷어내고 구버전을 정리한 뒤
     * 이 목록에 추가할 것. (REQUIRE_AUTH 전환과 같은 시점)
     */
    function serverOnlyFields() {
      return [
        // 사진 인식 횟수. b24부터 서버만 쓰던 필드라 잠가도 앱이 깨지지 않는다.
        'todayPhotoCount', 'todayPhotoAttempts', 'lastPhotoDate',

        // 기간(주·월·연) AI 평가 횟수. evaluatePeriod가 센다. 새 필드라 앱이 쓴 적이 없다.
        'periodEvalCount', 'periodEvalDate',

        // 구독 검증 결과. verifySubscription과 RTDN이 쓴다.
        //
        // isSubscribed 본체는 아직 못 막지만 이 셋은 지금 막아야 한다.
        // 안 그러면 나중에 isSubscribed를 잠그기 전에 미리
        //   isSubscribed: true, subscriptionExpiry: "2099-..."
        // 를 써둘 수 있고, 잠근 뒤에는 서버의 isSubscribedNow()가 이를 믿어
        // 영구 프리미엄이 된다. 앱 쓰기가 막혀 되돌릴 수도 없다.
        'subscriptionExpiry', 'subscriptionState', 'subscriptionCheckedAt'
      ];
    }

    // 유저 문서 본체. 서버 전용 필드만 빼고 기존과 동일하게 열려 있다.
    //
    // 아래 서브컬렉션 규칙과 분리한 이유:
    // rules_version 2의 {document=**}는 0개 세그먼트도 매칭해서 유저 문서 자신까지 포함한다.
    // 규칙은 OR로 평가되므로 한쪽이라도 열려 있으면 통과다. 즉 예전처럼 한 블록으로 두면
    // 여기서 필드를 막아도 서브컬렉션 규칙이 그대로 허용해 버린다.
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(serverOnlyFields());

      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny(serverOnlyFields());

      // 회원 탈퇴. b61부터는 서버(withdrawAccount 함수)가 Admin SDK로 지우므로 이 허용이 필요 없다.
      // b60 이하 구버전 앱은 아직 이 문서를 직접 지우니 당분간 열어 둔다.
      // 구버전이 사라지면(min_version_code를 61 이상으로 올린 뒤) 이 줄을 지워서
      // 문서 삭제로 사진 횟수를 초기화하는 우회까지 막는다.
      allow delete: if isOwner(userId);
    }

    // 하위 서브컬렉션(settlements 등)은 기존과 동일하게 본인만 읽고 쓴다.
    match /users/{userId}/{sub}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // 분석 횟수 무제한 사용자 (문서 ID = 소문자 이메일, 내용은 비어 있어도 됨)
    //
    // 본인 문서만 읽을 수 있으므로 등록된 이메일 목록 전체가 노출되지 않는다.
    // 추가/삭제는 콘솔에서만 한다 (앱에서는 쓰기 불가).
    match /unlimited_users/{email} {
      allow read: if request.auth != null
                  && request.auth.token.email != null
                  && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // 앱이 만든 구글 캘린더("데일리넷")의 ID. 문서 ID = 구글 계정 ID(sub), 내용은 { calendarId, email }.
    // email은 콘솔에서 어느 계정인지 알아보기 위한 것이고 조회 키는 문서 ID다.
    //
    // users/{uid} 밖에 두는 이유: 탈퇴하면 users 트리가 통째로 지워지고 재가입하면 uid도 바뀐다.
    // 그래도 구글 계정은 그대로이므로, 구글 계정 ID로 찾으면 기존 캘린더에 이어서 쓸 수 있다.
    // calendar.app.created 범위로는 캘린더 목록을 못 읽어(403) 이 ID가 되찾을 유일한 단서다.
    // 탈퇴(withdrawAccount 함수)가 이 문서는 지우지 않는 것이 의도다.
    match /calendar_ids/{googleId} {
      allow read, write: if request.auth != null
                         && request.auth.token.firebase.identities["google.com"][0] == googleId;
    }

  }
}
